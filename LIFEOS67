<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#292016">
<title>LIFE OS67 — The Brain Tree</title>
<style>
:root{
  --ink:#302316;--ink2:#49351f;--paper:#f0e2bd;--paper2:#e3d0a1;--cream:#fff4d8;
  --gold:#b88736;--gold2:#d9b66d;--brown:#76532e;--line:#8c6b3d;--green:#526c45;
  --red:#8a4939;--shadow:rgba(35,24,12,.22);
  --pixel: "Courier New", Courier, monospace;
  --display: Rockwell, "Roboto Slab", Georgia, serif;
}
*{box-sizing:border-box}
html,body{margin:0;min-height:100%;background:#211a12;color:var(--ink);font-family:var(--pixel)}
body{padding:12px 10px 28px;background:
 radial-gradient(ellipse at 50% 0%,#57432a 0%,#2a2117 55%,#1b160f 100%); }
button,input,select,textarea{font:inherit}
button{cursor:pointer}
.shell{width:min(100%,760px);margin:0 auto;border:5px ridge #b18a4d;background:var(--paper);box-shadow:0 12px 40px #0008;min-height:calc(100dvh - 40px);display:flex;flex-direction:column}
.top{background:linear-gradient(#f8edcf,#dfc994);border-bottom:4px double var(--brown);padding:14px 14px 10px;text-align:center}
.kicker{font-size:10px;letter-spacing:3px;color:#76552c;font-weight:bold}
h1{font-family:var(--display);font-weight:900;font-size:clamp(26px,7vw,42px);letter-spacing:1px;margin:5px 0 0;color:#49351f;text-shadow:1px 2px #fff7}
.subtitle{font-size:10px;letter-spacing:2px;margin-top:3px;color:#76552c}
.statusbar{display:flex;justify-content:space-between;gap:8px;background:#49351f;color:#f8e9c5;padding:8px 12px;font-size:11px;border-bottom:3px solid #a47a3b}
.statusbar span{white-space:nowrap}
main{padding:14px;flex:1}
.panel{border:3px double var(--line);background:linear-gradient(145deg,#fff4d8,#ead8ad);padding:14px;margin-bottom:13px;box-shadow:3px 4px 0 var(--shadow)}
.panel.dark{background:#49351f;color:#fff0cb;border-color:#b58a4a}
h2{font-family:var(--display);font-size:22px;margin:0 0 10px;color:#49351f}
.dark h2{color:#f2d69b}
h3{font-size:14px;margin:0 0 8px;color:#5b4022}
p{font-size:12px;line-height:1.6;margin:7px 0}
.small{font-size:10px;line-height:1.5;color:#765b37}
.dark .small{color:#e7d4aa}
.menu{display:grid;grid-template-columns:1fr 1fr;gap:9px}
.menu-btn,.btn{border:3px outset #b28a4b;background:linear-gradient(#fff2cf,#d8bd83);color:#49351f;padding:14px 10px;min-height:58px;text-align:left;font-weight:bold;font-size:12px;box-shadow:2px 3px 0 #76552c}
.menu-btn:active,.btn:active{border-style:inset;transform:translate(1px,1px);box-shadow:none}
.menu-btn .num{display:inline-block;border:1px solid #947143;padding:2px 5px;margin-right:6px;font-size:10px}
.menu-btn .desc{display:block;font-size:9px;font-weight:normal;margin:6px 0 0 26px;color:#755a35}
.btn{min-height:40px;padding:9px 12px;text-align:center;margin:4px 4px 4px 0}
.btn.primary{background:linear-gradient(#6b8052,#3e5835);color:#fff3d5;border-color:#a4b18b}
.btn.danger{background:linear-gradient(#b56d52,#7e3d30);color:white;border-color:#c08b70}
.btnrow{display:flex;flex-wrap:wrap;gap:5px;margin-top:10px}
.row{display:flex;align-items:center;justify-content:space-between;gap:10px}
.statgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:7px}
.stat{border:2px solid #ad8a53;background:#fff6df;padding:9px 6px;text-align:center}
.stat b{display:block;font-family:var(--display);font-size:21px;color:#5a3f20}
.stat span{font-size:9px;letter-spacing:1px}
.bar{height:12px;background:#c7b58c;border:1px solid #8b6a3c;margin:7px 0;overflow:hidden}
.bar>i{display:block;height:100%;background:repeating-linear-gradient(90deg,#62794c 0 8px,#82965e 8px 12px);width:0%}
.item{border:2px solid #b18b51;background:#fff5dc;padding:10px;margin:8px 0}
.item.locked{opacity:.7;background:#dfd2b2}
.item p{margin:4px 0}
.tag{font-size:9px;display:inline-block;border:1px solid #927143;padding:3px 5px;margin:2px;background:#f4e3b9}
.tag.open{background:#dbe4c8;border-color:#61784c}
.tag.lock{background:#ead0c4;border-color:#9c5a45}
input,select,textarea{width:100%;border:2px inset #b89a65;background:#fff9e9;padding:10px;color:#392918;margin:5px 0 9px;font-size:13px}
label{font-size:11px;font-weight:bold;display:block;margin-top:7px}
.progressrow{display:grid;grid-template-columns:1fr auto;gap:8px;align-items:center;font-size:11px}
.hidden{display:none!important}
.back{margin-bottom:12px}
.notice{padding:9px;border-left:4px solid var(--green);background:#e4e8d2;font-size:11px;line-height:1.5;margin:8px 0}
.warn{border-left-color:var(--red);background:#f0ddd0}
footer{text-align:center;background:#49351f;color:#e8d4a8;padding:10px;font-size:9px;letter-spacing:1px}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.choice{display:block;text-align:left;width:100%;background:#fff2d1;border:2px solid #9c7946;padding:10px;margin:6px 0;color:#49351f;font-size:12px}
.choice:disabled{opacity:.5}
#toast{position:fixed;left:50%;bottom:18px;transform:translateX(-50%);background:#302316;color:#fff0ca;border:2px solid #d9b66d;padding:10px 14px;z-index:20;font-size:11px;max-width:90%;text-align:center;box-shadow:0 4px 14px #0008}
.memory-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:7px}
.memory-card{min-height:62px;border:3px outset #b18a4d;background:#e2c995;font-size:20px;color:#49351f}
.memory-card.revealed{background:#fff4d8;border-style:inset}
.quiz-option{width:100%;text-align:left}
@media(max-width:390px){body{padding:0}.shell{min-height:100dvh;border-width:3px}.menu{grid-template-columns:1fr 1fr}.menu-btn{padding:11px 7px;font-size:11px}.statgrid{gap:4px}.stat b{font-size:18px}main{padding:10px}}
</style>
</head>
<body>
<div class="shell">
<header class="top">
 <div class="kicker">A PERSONAL DEVELOPMENT ADVENTURE</div>
 <h1>LIFE OS67</h1>
 <div class="subtitle">THE BRAIN TREE • PLAYER EDITION</div>
</header>
<div class="statusbar"><span id="levelLabel">LIFE LEVEL 01</span><span id="xpLabel">0 XP</span><span id="saveLabel">SAVED LOCALLY</span></div>
<main id="app"></main>
<footer>GROW • LEARN • BUILD • EVOLVE &nbsp; | &nbsp; LIFE OS67 v0.4</footer>
</div>
<div id="toast" class="hidden" role="status"></div>
<script>
(() => {
"use strict";
const STORE_KEY = "lifeos67";
const $ = id => document.getElementById(id);
const escapeHTML = s => String(s ?? "").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const defaultSkills = [
 {id:"knowledge",name:"Knowledge",branch:"Intelligence",level:90,source:"Player-entered",evidence:"Previously entered player level.",threshold:0},
 {id:"memory",name:"Memory",branch:"Intelligence",level:null,source:"Unknown",threshold:20},
 {id:"reasoning",name:"Reasoning",branch:"Intelligence",level:null,source:"Unknown",threshold:50},
 {id:"creativity",name:"Creativity",branch:"Creation",level:null,source:"Unknown",threshold:80},
 {id:"communication",name:"Communication",branch:"Social",level:null,source:"Unknown",threshold:120},
 {id:"leadership",name:"Leadership",branch:"Social",level:null,source:"Unknown",threshold:180},
 {id:"planning",name:"Planning",branch:"Execution",level:null,source:"Unknown",threshold:250},
 {id:"focus",name:"Focus",branch:"Execution",level:null,source:"Unknown",threshold:320},
 {id:"numeracy",name:"Numeracy",branch:"Intelligence",level:null,source:"Unknown",threshold:400},
 {id:"reaction",name:"Reaction",branch:"Performance",level:null,source:"Unknown",threshold:480},
 {id:"problem-solving",name:"Problem Solving",branch:"Intelligence",level:null,source:"Unknown",threshold:560}
];
const defaults = () => ({
 version:4, player:{name:"Player",lifeLevel:1,xp:0,totalXP:0},
 skills:defaultSkills.map(x=>({...x,unlocked:x.threshold===0})),
 missions:[
  {id:"m1",title:"Daily Learning",description:"Spend time learning something new and record what you learned.",xp:10,done:false},
  {id:"m2",title:"Build Something",description:"Make progress on a project or practical skill.",xp:15,done:false},
  {id:"m3",title:"Reflect and Improve",description:"Review a decision, result or experience and identify one lesson.",xp:10,done:false}
 ],
 achievements:[],scores:{},history:[],createdAt:new Date().toISOString()
});
let data;
function load(){
 let raw=null;try{raw=JSON.parse(localStorage.getItem(STORE_KEY)||"null")}catch(e){}
 // Preserve the previous LIFE OS67 object intact; v0.4 stores its own data alongside it.
 if(raw && raw._lifeos67v04){data=raw._lifeos67v04}
 else{
   data=defaults();
   if(raw && typeof raw==="object"){
     data.legacyPreserved=true;
     // Read only well-known fields where safe; retain the entire previous object under legacy.
     data.legacy=raw;
     const oldXP=Number(raw.xp ?? raw.totalXP ?? raw.progress?.xp);
     if(Number.isFinite(oldXP)&&oldXP>0){data.player.xp=oldXP;data.player.totalXP=oldXP}
     const oldLevel=Number(raw.lifeLevel ?? raw.level);
     if(Number.isFinite(oldLevel)&&oldLevel>0)data.player.lifeLevel=oldLevel;
   }
 }
 data.player ||= {name:"Player",lifeLevel:1,xp:0,totalXP:0};
 data.skills ||= defaultSkills;
 data.missions ||= defaults().missions;
 data.achievements ||= [];data.scores ||= {};data.history ||= [];
 autoUnlock();
 save();
}
function save(){
 try{
  let old={};try{old=JSON.parse(localStorage.getItem(STORE_KEY)||"{}")||{}}catch(e){}
  old._lifeos67v04=data;
  localStorage.setItem(STORE_KEY,JSON.stringify(old));
  $("saveLabel").textContent="SAVED LOCALLY";
 }catch(e){$("saveLabel").textContent="SAVE ERROR";}
 updateStatus();
}
function updateStatus(){
 const xp=Number(data.player.xp)||0,level=Math.floor(xp/100)+1,within=xp%100;
 data.player.lifeLevel=level;
 $("levelLabel").textContent="LIFE LEVEL "+String(level).padStart(2,"0");
 $("xpLabel").textContent=xp+" XP";
}
function toast(msg){const t=$("toast");t.textContent=msg;t.classList.remove("hidden");clearTimeout(toast.timer);toast.timer=setTimeout(()=>t.classList.add("hidden"),2400)}
function addXP(amount,reason){
 amount=Math.max(0,Math.floor(Number(amount)||0));if(!amount)return;
 data.player.xp=(Number(data.player.xp)||0)+amount;data.player.totalXP=(Number(data.player.totalXP)||0)+amount;
 data.history.push({date:new Date().toISOString(),xp:amount,reason});
 autoUnlock();save();toast("+"+amount+" XP — "+reason);
}
function autoUnlock(){
 const xp=Number(data.player.xp)||0;
 (data.skills||[]).forEach(s=>{if(!s.unlocked && xp>=Number(s.threshold||Infinity)){s.unlocked=true;s.unlockedAt=new Date().toISOString();}});
}
let current="home";
function go(page){current=page;render()}
function backButton(){return `<button class="btn back" onclick="go('home')">◀ MAIN MENU</button>`}
function home(){
 return `<section class="panel dark"><h2>WELCOME BACK, PLAYER</h2><p>Your journey is built through learning, practice, missions and discoveries. Your progress is saved on this device.</p><div class="statgrid"><div class="stat"><b>${data.player.lifeLevel}</b><span>LIFE LEVEL</span></div><div class="stat"><b>${data.player.xp}</b><span>XP</span></div><div class="stat"><b>${data.skills.filter(s=>s.unlocked).length}</b><span>UNLOCKED</span></div></div><div class="bar"><i style="width:${data.player.xp%100}%"></i></div><p class="small">${data.player.xp%100}/100 XP towards your next Life Level</p></section>
 <section class="panel"><h2>MAIN MENU</h2><div class="menu">
 <button class="menu-btn" onclick="go('profile')"><span class="num">01</span>PLAYER PROFILE<span class="desc">Your level, attributes and progress</span></button>
 <button class="menu-btn" onclick="go('map')"><span class="num">02</span>LIFE MAP<span class="desc">Explore branches and skills</span></button>
 <button class="menu-btn" onclick="go('missions')"><span class="num">03</span>MISSIONS<span class="desc">Challenges and XP rewards</span></button>
 <button class="menu-btn" onclick="go('games')"><span class="num">04</span>MINIGAMES<span class="desc">Play, practise and develop</span></button>
 <button class="menu-btn" onclick="go('archive')"><span class="num">05</span>KNOWLEDGE ARCHIVE<span class="desc">Your learning records</span></button>
 <button class="menu-btn" onclick="go('achievements')"><span class="num">06</span>ACHIEVEMENTS<span class="desc">Milestones and records</span></button>
 <button class="menu-btn" onclick="go('ai')"><span class="num">07</span>MATT'S LEVEL AI<span class="desc">Your local development guide</span></button>
 <button class="menu-btn" onclick="go('options')"><span class="num">08</span>OPTIONS & DATA<span class="desc">Save, export and settings</span></button>
 </div></section>`;
}
function profile(){
 const xp=data.player.xp||0;
 return `${backButton()}<section class="panel"><h2>PLAYER PROFILE</h2><label>PLAYER NAME</label><input id="playerName" value="${escapeHTML(data.player.name)}" maxlength="30"><button class="btn" onclick="saveName()">SAVE NAME</button><div class="statgrid"><div class="stat"><b>${data.player.lifeLevel}</b><span>LIFE LEVEL</span></div><div class="stat"><b>${xp}</b><span>TOTAL XP</span></div><div class="stat"><b>${data.skills.filter(s=>s.unlocked).length}</b><span>SKILLS OPEN</span></div></div><div class="bar"><i style="width:${xp%100}%"></i></div><p>${xp%100}/100 XP to next level</p></section>
 <section class="panel"><h2>ATTRIBUTES & SKILLS</h2>${data.skills.map(s=>`<div class="item ${s.unlocked?"":"locked"}"><div class="row"><b>${escapeHTML(s.name)}</b><span class="tag ${s.unlocked?"open":"lock"}">${s.unlocked?"UNLOCKED":"LOCKED"}</span></div><p class="small">${escapeHTML(s.branch)} • Level ${s.level==null?"—":s.level+"/100"} • ${escapeHTML(s.source||"Unknown")}</p>${s.unlocked?`<label>Set your level (1–100)</label><input type="number" min="1" max="100" id="skill-${escapeHTML(s.id)}" value="${s.level??""}" placeholder="Not set"><button class="btn" onclick="setSkill('${escapeHTML(s.id)}')">UPDATE LEVEL</button>`:`<p class="small">Unlock requirement: ${s.threshold} XP</p>`}</div>`).join("")}</section>`;
}
function mapPage(){
 const branches=[...new Set(data.skills.map(s=>s.branch))];
 return `${backButton()}<section class="panel"><h2>THE BRAIN TREE</h2><p>Skills open automatically as your XP reaches their requirements. Locked skills show their unlock target. Skill levels remain separate from XP.</p></section>${branches.map(b=>`<section class="panel"><h3>${escapeHTML(b.toUpperCase())}</h3>${data.skills.filter(s=>s.branch===b).map(s=>`<div class="item ${s.unlocked?"":"locked"}"><div class="row"><b>${escapeHTML(s.name)}</b><span class="tag ${s.unlocked?"open":"lock"}">${s.unlocked?"OPEN":"LOCKED"}</span></div><p class="small">${s.unlocked?"Available to develop":`Opens at ${s.threshold} XP`} • Level ${s.level??"—"}</p></div>`).join("")}</section>`).join("")}`;
}
function missions(){
 return `${backButton()}<section class="panel"><h2>MISSION CENTRE</h2><p>Complete a real-world challenge, then mark it complete to receive its XP. Only completed missions award XP.</p>${data.missions.map(m=>`<div class="item"><b>${escapeHTML(m.title)}</b><p>${escapeHTML(m.description)}</p><span class="tag">${m.xp} XP</span><span class="tag ${m.done?"open":""}">${m.done?"COMPLETED":"AVAILABLE"}</span>${m.done?"":`<div><button class="btn primary" onclick="completeMission('${m.id}')">MARK COMPLETE</button></div>`}</div>`).join("")}<div class="notice">Add your own missions in a future update. These starter missions can be completed once.</div></section>`;
}
function games(){
 return `${backButton()}<section class="panel"><h2>MINIGAMES</h2><p>Play short challenges. Scores award XP and contribute to the related skill areas. Repeated attempts have limited XP rewards so progress comes from performance.</p><div class="item"><b>MEMORY MATCH</b><p>Find all matching pairs.</p><button class="btn primary" onclick="startMemory()">PLAY</button></div><div class="item"><b>KNOWLEDGE QUIZ</b><p>Answer general knowledge questions.</p><button class="btn primary" onclick="startQuiz()">PLAY</button></div><div class="item"><b>NUMBER RUSH</b><p>Solve quick arithmetic questions.</p><button class="btn primary" onclick="startMath()">PLAY</button></div><div class="item"><b>REACTION TEST</b><p>Wait for the signal, then tap as quickly as you can.</p><button class="btn primary" onclick="startReaction()">PLAY</button></div><div class="item"><b>PATTERN FINDER</b><p>Work out the next number in a sequence.</p><button class="btn primary" onclick="startPattern()">PLAY</button></div><div class="item"><b>PROBLEM SOLVER</b><p>Try a short logic puzzle.</p><button class="btn primary" onclick="startLogic()">PLAY</button></div></section>`;
}
let gameTimer=null,gameState={};
function awardGame(key,score,max,skill,base){
 const old=data.scores[key]||{best:0,plays:0,totalXP:0};old.plays++;old.best=Math.max(old.best,score);
 const earned=Math.max(0,Math.round(base*score/max));
 // First play and genuine score improvement can earn XP; repeat farming is limited.
 const xp=old.plays===1?earned:(score>old.best?Math.max(1,Math.floor(earned/2)):0);
 old.totalXP+=xp;data.scores[key]=old;
 if(skill){let s=data.skills.find(x=>x.id===skill);if(s&&s.unlocked){s.level=Math.min(100,(s.level||1)+Math.max(1,Math.floor(score/max*2)));s.source="Game-assessed";}}
 save();if(xp)addXP(xp,key+" result");else toast("Score saved. No repeat XP this time.");
}
function startMemory(){
 const symbols=["★","◆","●","▲","♥","♣"];let cards=[...symbols,...symbols].sort(()=>Math.random()-.5);
 gameState={cards,open:[],matched:[],moves:0};renderGame(`<h2>MEMORY MATCH</h2><p>Find the six matching pairs.</p><div class="memory-grid" id="memoryGrid">${cards.map((x,i)=>`<button class="memory-card" onclick="flipCard(${i})" id="mc${i}">?</button>`).join("")}</div><p id="memoryInfo">Moves: 0</p><button class="btn" onclick="go('games')">QUIT</button>`);
}
function flipCard(i){
 let g=gameState;if(g.open.includes(i)||g.matched.includes(i))return;
 g.open.push(i);$("mc"+i).textContent=g.cards[i];$("mc"+i).classList.add("revealed");
 if(g.open.length===2){g.moves++;if(g.cards[g.open[0]]===g.cards[g.open[1]]){g.matched.push(...g.open);g.open=[];}else{const pair=[...g.open];setTimeout(()=>{pair.forEach(n=>{if(!g.matched.includes(n)){$("mc"+n).textContent="?";$("mc"+n).classList.remove("revealed")}});g.open=[]},650)}
 $("memoryInfo").textContent="Moves: "+g.moves+" • Pairs: "+g.matched.length/2;
 if(g.matched.length===12){const score=Math.max(1,Math.round(100-((g.moves-6)*5)));awardGame("memory",score,100,"memory",12);$("gameArea").insertAdjacentHTML("beforeend",`<div class="notice">All pairs found! Score: ${score}/100</div><button class="btn primary" onclick="go('games')">BACK TO MINIGAMES</button>`)}
 }
}
const quizQs=[
 ["Which planet is known as the Red Planet?",["Venus","Mars","Jupiter"],1],
 ["How many sides does a hexagon have?",["Five","Six","Eight"],1],
 ["What is the largest ocean on Earth?",["Atlantic","Indian","Pacific"],2],
 ["Which gas do plants absorb?",["Carbon dioxide","Oxygen","Helium"],0],
 ["What is 12 × 8?",["86","96","108"],1]
];
function startQuiz(){gameState={q:0,score:0};showQuiz()}
function showQuiz(){let g=gameState;if(g.q>=quizQs.length){awardGame("quiz",g.score*20,100,"knowledge",10);renderGame(`<h2>QUIZ COMPLETE</h2><p>You scored ${g.score} out of ${quizQs.length}.</p><div class="stat"><b>${g.score*20}/100</b><span>SCORE</span></div><button class="btn primary" onclick="go('games')">BACK TO MINIGAMES</button>`);return}
 let q=quizQs[g.q];renderGame(`<h2>KNOWLEDGE QUIZ</h2><p>Question ${g.q+1} of ${quizQs.length}</p><h3>${q[0]}</h3>${q[1].map((a,i)=>`<button class="choice quiz-option" onclick="answerQuiz(${i})">${String.fromCharCode(65+i)}. ${a}</button>`).join("")}<p>Correct: ${g.score}</p>`)}
function answerQuiz(i){if(i===quizQs[gameState.q][2])gameState.score++;gameState.q++;showQuiz()}
function startMath(){gameState={q:0,score:0};showMath()}
function showMath(){let g=gameState;if(g.q>=5){awardGame("math",g.score*20,100,"numeracy",10);renderGame(`<h2>NUMBER RUSH COMPLETE</h2><p>Correct answers: ${g.score}/5</p><button class="btn primary" onclick="go('games')">BACK TO MINIGAMES</button>`);return}
 const a=Math.floor(Math.random()*12)+2,b=Math.floor(Math.random()*9)+2;g.a=a;g.b=b;g.answer=a*b;
 renderGame(`<h2>NUMBER RUSH</h2><p>Question ${g.q+1} of 5</p><h3>${a} × ${b} = ?</h3><input id="mathAnswer" type="number" inputmode="numeric" placeholder="Your answer"><button class="btn primary" onclick="answerMath()">SUBMIT</button><p>Correct: ${g.score}</p>`)}
function answerMath(){if(Number($("mathAnswer").value)===gameState.answer)gameState.score++;gameState.q++;showMath()}
function startReaction(){gameState={state:"wait",start:0};renderGame(`<h2>REACTION TEST</h2><p>Tap the button only when it turns green. Don't jump the signal.</p><button id="reactionBtn" class="btn" style="width:100%;height:100px" onclick="reactionTap()">WAIT FOR SIGNAL</button><p id="reactionInfo">Get ready…</p>`);gameTimer=setTimeout(()=>{if(gameState.state==="wait"){gameState.state="go";gameState.start=Date.now();$("reactionBtn").classList.add("primary");$("reactionBtn").textContent="TAP NOW!"}},1200+Math.random()*2800)}
function reactionTap(){if(gameState.state==="wait"){clearTimeout(gameTimer);gameState.state="early";$("reactionInfo").textContent="Too early! Try again."; $("reactionBtn").textContent="TRY AGAIN";$("reactionBtn").onclick=startReaction;return}
 if(gameState.state==="go"){let ms=Date.now()-gameState.start;let score=Math.max(0,Math.min(100,Math.round(100-(ms-180)/8)));awardGame("reaction",score,100,"reaction",10);$("reactionInfo").textContent=`Your time: ${ms} ms • Score: ${score}/100`;$("reactionBtn").textContent="PLAY AGAIN";$("reactionBtn").onclick=startReaction;gameState.state="done"}}
const patterns=[[2,4,6,8,10],[3,6,12,24,48],[1,1,2,3,5],[5,10,20,40,80]];
function startPattern(){gameState={q:0,score:0};showPattern()}
function showPattern(){let g=gameState;if(g.q>=patterns.length){awardGame("pattern",g.score*25,100,"reasoning",10);renderGame(`<h2>PATTERN FINDER COMPLETE</h2><p>Correct: ${g.score}/${patterns.length}</p><button class="btn primary" onclick="go('games')">BACK TO MINIGAMES</button>`);return}
 const p=patterns[g.q];renderGame(`<h2>PATTERN FINDER</h2><p>Sequence ${g.q+1} of ${patterns.length}</p><h3>${p.join(" • ")} • ?</h3><input id="patternAnswer" type="number" placeholder="Next number"><button class="btn primary" onclick="answerPattern()">SUBMIT</button>`);gameState.answer=p[p.length-1]+(p[1]-p[0])}
function answerPattern(){const p=patterns[gameState.q];const correct=gameState.q===1?96:gameState.q===2?8:gameState.q===3?160:12;if(Number($("patternAnswer").value)===correct)gameState.score++;gameState.q++;showPattern()}
function startLogic(){gameState={q:0,score:0};showLogic()}
const logicQs=[["A farmer has 17 sheep. All but 9 run away. How many remain?",9],["You have 3 apples and take away 2. How many do you have?",2],["A clock shows 3:15. What is the angle between the hands (smaller angle)?",7.5]];
function showLogic(){if(gameState.q>=logicQs.length){awardGame("logic",Math.round(gameState.score/3*100),100,"reasoning",10);renderGame(`<h2>PROBLEM SOLVER COMPLETE</h2><p>Correct: ${gameState.score}/3</p><button class="btn primary" onclick="go('games')">BACK TO MINIGAMES</button>`);return}
let q=logicQs[gameState.q];renderGame(`<h2>PROBLEM SOLVER</h2><p>Puzzle ${gameState.q+1} of 3</p><h3>${q[0]}</h3><input id="logicAnswer" type="number" step="0.5" placeholder="Your answer"><button class="btn primary" onclick="answerLogic()">SUBMIT</button>`)}
function answerLogic(){if(Math.abs(Number($("logicAnswer").value)-logicQs[gameState.q][1])<0.01)gameState.score++;gameState.q++;showLogic()}
function renderGame(content){$("app").innerHTML=`<button class="btn back" onclick="go('games')">◀ MINIGAMES</button><section class="panel" id="gameArea">${content}</section>`}
function archive(){return `${backButton()}<section class="panel"><h2>KNOWLEDGE ARCHIVE</h2><p>Keep useful learning records. This prototype stores entries on this device.</p><label>NEW KNOWLEDGE ENTRY</label><input id="knowledgeTitle" placeholder="What did you learn?"><textarea id="knowledgeBody" rows="3" placeholder="Notes, evidence or useful details"></textarea><button class="btn primary" onclick="addKnowledge()">SAVE ENTRY</button><div id="knowledgeList">${(data.knowledge||[]).slice().reverse().map((k,i)=>`<div class="item"><b>${escapeHTML(k.title)}</b><p>${escapeHTML(k.body)}</p><span class="small">${new Date(k.date).toLocaleDateString()}</span></div>`).join("")}</div></section>`}
function achievements(){return `${backButton()}<section class="panel"><h2>ACHIEVEMENTS</h2><div class="item"><b>FIRST STEPS</b><p>Reach Life Level 2.</p><span class="tag ${data.player.lifeLevel>=2?"open":"lock"}">${data.player.lifeLevel>=2?"EARNED":"LOCKED"}</span></div><div class="item"><b>MINIGAME STARTER</b><p>Play your first minigame.</p><span class="tag ${Object.values(data.scores).some(s=>s.plays>0)?"open":"lock"}">${Object.values(data.scores).some(s=>s.plays>0)?"EARNED":"LOCKED"}</span></div><div class="item"><b>BRAIN TREE GROWTH</b><p>Unlock five skills.</p><span class="tag ${data.skills.filter(s=>s.unlocked).length>=5?"open":"lock"}">${data.skills.filter(s=>s.unlocked).length>=5?"EARNED":"LOCKED"}</span></div><h3>MINIGAME RECORDS</h3>${Object.entries(data.scores).map(([k,v])=>`<div class="item"><b>${escapeHTML(k.toUpperCase())}</b><p>Best: ${v.best} • Plays: ${v.plays} • XP earned: ${v.totalXP}</p></div>`).join("")||"<p>No records yet. Try a minigame!</p>"}</section>`}
function ai(){return `${backButton()}<section class="panel"><h2>MATT'S LEVEL AI</h2><p>This is the local prototype guide. It can explain your saved progress and suggest practical next steps. It is not yet connected to a live cloud AI service.</p><label>WHAT WOULD YOU LIKE HELP WITH?</label><textarea id="aiPrompt" rows="3" placeholder="Example: How can I improve my memory?"></textarea><button class="btn primary" onclick="askAI()">ASK MATT'S LEVEL AI</button><div id="aiAnswer" class="notice hidden"></div></section>`}
function options(){return `${backButton()}<section class="panel"><h2>OPTIONS & DATA</h2><p>Your records are saved in this browser on this device. Export a backup regularly, especially before clearing browser data.</p><button class="btn primary" onclick="exportData()">EXPORT PLAYER DATA</button><label>RESTORE FROM JSON BACKUP</label><input id="restoreFile" type="file" accept="application/json"><button class="btn" onclick="importData()">RESTORE BACKUP</button><div class="notice warn">Restoring replaces the current v0.4 player record. Export a backup first. The previous stored LIFE OS67 data is preserved in the local storage record during the initial upgrade.</div><h3>PROGRESSION RULES</h3><p>Skills unlock automatically at their XP thresholds. XP does not directly set a skill's 1–100 level. Minigames award limited XP based on performance.</p><button class="btn danger" onclick="resetData()">RESET V0.4 PLAYER DATA</button></section>`}
function render(){
 updateStatus();
 const pages={home,profile,map:mapPage,missions,games,archive,achievements,ai,options};
 $("app").innerHTML=(pages[current]||home)();
}
window.go=go;
window.saveName=()=>{data.player.name=$("playerName").value.trim()||"Player";save();toast("Player name saved.")};
window.setSkill=id=>{let s=data.skills.find(x=>x.id===id);let v=Number($("skill-"+id).value);if(!Number.isInteger(v)||v<1||v>100){toast("Enter a level from 1 to 100.");return}s.level=v;s.source="Player-entered";save();toast(s.name+" level updated.");render()};
window.completeMission=id=>{let m=data.missions.find(x=>x.id===id);if(!m||m.done)return;m.done=true;save();addXP(m.xp,m.title+" mission");render()};
window.addKnowledge=()=>{let title=$("knowledgeTitle").value.trim(),body=$("knowledgeBody").value.trim();if(!title||!body){toast("Add a title and some notes first.");return}data.knowledge||=[];data.knowledge.push({title,body,date:new Date().toISOString()});save();render();toast("Knowledge entry saved.")};
window.askAI=()=>{let q=$("aiPrompt").value.trim();if(!q){toast("Write a question first.");return}let a="Your current Life Level is "+data.player.lifeLevel+" with "+data.player.xp+" XP. You have "+data.skills.filter(s=>s.unlocked).length+" unlocked skills. Start with one small practical action, record evidence of what you do, and review the result. This local prototype cannot independently research or understand free-form questions yet.";let box=$("aiAnswer");box.textContent=a;box.classList.remove("hidden")};
window.exportData=()=>{const blob=new Blob([JSON.stringify(data,null,2)],{type:"application/json"});const url=URL.createObjectURL(blob);const a=document.createElement("a");a.href=url;a.download="LIFE-OS67-player-backup.json";a.click();URL.revokeObjectURL(url)};
window.importData=()=>{const f=$("restoreFile").files[0];if(!f){toast("Choose a backup file first.");return}const r=new FileReader();r.onload=()=>{try{const d=JSON.parse(r.result);if(!d.player||!Array.isArray(d.skills))throw Error("Invalid backup");data=d;save();go("home");toast("Backup restored.")}catch(e){toast("That backup file could not be read.")}};r.readAsText(f)};
window.resetData=()=>{if(!confirm("Reset the v0.4 player data on this device? Export a backup first. Previous legacy data is not deliberately deleted."))return;const legacy=data.legacy;data=defaults();if(legacy)data.legacy=legacy;save();go("home");toast("v0.4 player data reset.")};
window.startMemory=startMemory;window.flipCard=flipCard;window.startQuiz=startQuiz;window.answerQuiz=answerQuiz;window.startMath=startMath;window.answerMath=answerMath;window.startReaction=startReaction;window.reactionTap=reactionTap;window.startPattern=startPattern;window.answerPattern=answerPattern;window.startLogic=startLogic;window.answerLogic=answerLogic;
load();render();
})();
</script>
</body>
</html>
