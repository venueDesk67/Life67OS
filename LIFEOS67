function updateAttribute(i,v){
 const n=Number(v);
 if(!Number.isFinite(n)||n<1||n>100)return alert("Enter a level from 1 to 100.");
 state.attributes[i].level=n;
 state.attributes[i].source="Player-updated";
 save();
}
function updateSpec(i,j,v){
 const n=Number(v);
 if(!Number.isFinite(n)||n<1||n>100)return alert("Enter a level from 1 to 100.");
 state.specs[i].skills[j].level=n;
 state.specs[i].skills[j].source="Player-updated";
 save();
 showSpec(i);
}
