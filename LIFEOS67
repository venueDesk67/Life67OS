function localAI(q){
 const t=q.toLowerCase();
 const avg=(state.attributes.reduce((sum,a)=>sum+a.level,0)/Math.max(1,state.attributes.length)).toFixed(1);
 const active=state.missions.filter(m=>!m.done).length;
 const completed=state.missionHistory.length;
 const weakest=state.attributes.slice().sort((a,b)=>a.level-b.level)[0];
 const best=state.attributes.slice().sort((a,b)=>b.level-a.level)[0];
 if(/what next|recommend|focus|weak|improve/.test(t)){
  return "Your lowest recorded core attribute is "+weakest.name+" at "+weakest.level+"/100. Your highest is "+best.name+" at "+best.level+"/100. A useful next step is to choose "+weakest.name+" on the mission board and complete one knowledge, practical or performance challenge. Your current mission history contains "+completed+" completed challenges.";
 }
 if(/profile|attribute|level|character/.test(t)){
  return "Your current new Player Level is "+playerLevel()+" with "+state.xp+" new XP. Your current core attribute average is "+avg+"/100. This is calculated from the saved attribute levels. Your historical profile and historical 515 XP are separate from new gameplay XP.";
 }
 if(/brain tree|unlock|branch/.test(t)){
  return "You have "+unlockedBranches()+" of "+branches.length+" main branches unlocked using new XP. The next branch requirement is shown on the Brain Tree. Unlocking a branch opens a development pathway; it does not prove mastery.";
 }
 if(/mission|task|challenge/.test(t)){
  return "The generator currently provides three available missions for every registered target. There are "+allTargets().length+" levelable targets in your current profile. You have completed "+completed+" missions. Choose a target on the Mission Board to see its challenges.";
 }
 if(/project/.test(t)){
  return "Your archive contains "+state.projects.length+" projects. The original seven are retained as training archive records unless you update their status.";
 }
 if(/skill|special/.test(t)){
  return "Your profile contains "+state.specs.length+" historical specialisations, "+state.customSkills.length+" additional skills and "+state.abilities.length+" player-created abilities. Detailed historical records remain available where recovered. Missing records are not invented.";
 }
 if(/xp|experience|progress/.test(t)){
  return "You have "+state.xp+" new Player XP and are Level "+playerLevel()+". You have "+completed+" completed missions and a "+(state.streak||0)+" day mission streak. Minigame XP is limited to 50 per day.";
 }
 if(/streak/.test(t))return "Your current recorded mission streak is "+(state.streak||0)+" day(s). A streak increases when you complete at least one mission on consecutive calendar days.";
 if(/help|what can you/.test(t)){
  return "I can inspect your profile, identify low recorded attributes, explain XP and Brain Tree unlocks, count missions, review your projects and recommend a development activity. Ask about a specific area or type 'what next'.";
 }
 return "I can use your saved profile and mission history to give a more specific recommendation. Try asking 'what should I work on next?', 'show my weakest attribute', 'how many missions have I completed?' or 'explain my Brain Tree'. I am currently a local rules-based assistant, not an external AI model.";
}
function clearChat(){
 document.getElementById("chatlog").textContent="Matt's Level AI: Ready. Ask me about your character or development.";
}

function exportData(){
 const payload={format:"LIFE OS67",version:6,exported:new Date().toISOString(),state};
 const blob=new Blob([JSON.stringify(payload,null,2)],{type:"application/json"});
 const url=URL.createObjectURL(blob);
 const a=document.createElement("a");
 a.href=url;a.download="LIFE-OS67-backup-v06.json";
 document.body.appendChild(a);a.click();a.remove();
 setTimeout(()=>URL.revokeObjectURL(url),1000);
}
function importData(){
 const file=document.getElementById("importfile").files[0];
 if(!file)return alert("Choose a backup file first.");
 const reader=new FileReader();
 reader.onload=()=>{
  try{
   const data=JSON.parse(reader.result);
   const imported=normalise(data.state||data);
   if(!Array.isArray(imported.attributes)||!Array.isArray(imported.specs)||!Array.isArray(imported.projects))throw Error("Invalid structure");
   if(!confirm("Replace the current LIFE OS67 data with this backup? Export your current data first if you need a copy."))return;
   state=imported;save();alert("Backup restored.");
  }catch(e){alert("This does not appear to be a valid LIFE OS67 backup.");}
 };
 reader.readAsText(file);
}
function resetData(){
 if(!confirm("Reset new gameplay progress, missions, abilities and custom skills? Your historical seed profile and original project archive will remain. Export first."))return;
 const keepAttributes=historical.attributes.map(x=>({name:x[0],level:x[1],source:"Historical AI assessment"}));
 const keepSpecs=historical.specs.map(x=>({...x,skills:x.skills.map(s=>({name:s[0],level:s[1],source:"Historical AI assessment"}))}));
 state=fresh();
 state.attributes=keepAttributes;state.specs=keepSpecs;
 save();
 alert("New gameplay progress has been reset. Historical seed records remain.");
}

load();
render();
</script>
