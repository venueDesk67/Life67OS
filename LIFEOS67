function startMission(id){
 const targetId=id.split("|")[0];
 const target=getTarget(targetId);
 if(!target)return alert("This mission target is no longer available.");
 const mission=makeMissionSet(target).find(m=>m.id===id);
 if(!mission)return alert("This mission has refreshed. Choose one of the current challenges.");
 currentMission=mission;
 document.getElementById("challengearea").innerHTML=`
  <div class="panel">
   <span class="tag">${esc(mission.kind)} · ${esc(mission.difficulty)}</span>
   <h3>${esc(mission.title)}</h3>
   <p>${esc(mission.targetName)} · ${mission.minutes} minutes · Reward up to ${mission.xp} XP</p>
   <div class="objective"><strong>YOUR OBJECTIVE</strong><br>${esc(mission.objective)}</div>
   <label>Your response / work completed</label>
   <textarea id="challengeanswer" placeholder="Show your reasoning, work, result or practical action. Be specific..."></textarea>
   <label>Evidence, result or reflection</label>
   <textarea id="challengeevidence" placeholder="What did you produce or do? What was the result? What could support your account?"></textarea>
   <label><input id="challengeconfirm" type="checkbox" style="width:auto;min-height:0;margin:8px 5px 8px 0"> I confirm I have genuinely completed the activity described.</label>
   <p class="small">Assessment is based on the detail and evidence you submit. The local game cannot independently verify real-world claims.</p>
   <button class="action primary" onclick="submitMission()">Submit for assessment</button>
   <button class="action" onclick="show('missions')">Return to missions</button>
  </div>`;
 show("challenge");
}

function submitMission(){
 if(!currentMission)return;
 const answer=document.getElementById("challengeanswer").value.trim();
 const evidence=document.getElementById("challengeevidence").value.trim();
 const confirmed=document.getElementById("challengeconfirm").checked;
 if(answer.length<30)return alert("Add more detail to your response. Aim for at least 30 characters.");
 if(evidence.length<15)return alert("Add a brief evidence or reflection note.");
 if(!confirmed)return alert("Confirm that you genuinely completed the activity before submitting.");
 const total=answer.length+evidence.length;
 let quality=total>=500?1:total>=250?.85:total>=120?.7:.55;
 const awarded=Math.max(5,Math.round(currentMission.xp*quality));
 const target=getTarget(currentMission.targetId);
 if(!target)return alert("The mission target could not be found.");
 const before=skillLevelFromXP(target);
 state.xp+=awarded;
 if(target.type!=="player"&&target.type!=="branch"){
  state.skillXP[target.id]=(state.skillXP[target.id]||0)+awarded;
  applySkillLevel(target);
 }
 const today=dayKey();
 if(state.lastMissionDay===today){
  // Same-day completions do not break a streak.
 }else{
  const yesterday=new Date();yesterday.setDate(yesterday.getDate()-1);
  const ykey=yesterday.getFullYear()+"-"+String(yesterday.getMonth()+1).padStart(2,"0")+"-"+String(yesterday.getDate()).padStart(2,"0");
  state.streak=state.lastMissionDay===ykey?(state.streak||0)+1:1;
  state.lastMissionDay=today;
 }
 const after=getTarget(currentMission.targetId);
 const afterLevel=after?skillLevelFromXP(after):before;
 const record={
  id:currentMission.id,title:currentMission.title,targetId:currentMission.targetId,
  targetName:currentMission.targetName,awarded,date:today,
  answer,evidence,quality:Math.round(quality*100),
  levelBefore:before,levelAfter:afterLevel
 };
 state.missionHistory.push(record);
 state.missionCounts[currentMission.targetId]=missionCycle(currentMission.targetId)+1;
 state.missions.push({...record,done:true});
 if(state.missions.length>500)state.missions=state.missions.slice(-500);
 currentMission=null;
 save();
 document.getElementById("challengearea").innerHTML=`
  <div class="panel">
   <span class="tag good">CHALLENGE ASSESSED</span>
   <h3>Mission complete</h3>
   <p>You earned <strong>${awarded} XP</strong>.</p>
   <p>Assessment detail score: ${Math.round(quality*100)}%. This reflects the detail supplied, not independent verification.</p>
   <p>Player Level: ${playerLevel()}</p>
   <p>Relevant skill progression: ${before} → ${afterLevel}</p>
   <p>Mission streak: ${state.streak||1} day(s).</p>
   <button class="action primary" onclick="show('missions','${esc(record.targetId)}')">Play next mission</button>
   <button class="action" onclick="show('home')">Return home</button>
  </div>`;
 show("challenge");
}

function applySkillLevel(target){
 if(!target||!target.obj)return;
 const xp=skillProgress(target.id);
 const increase=Math.floor(xp/100);
 if(increase<=0)return;
 const obj=target.obj;
 const initial=Number(obj.level)||1;
 const applied=Number(obj.appliedSkillLevels)||0;
 const delta=increase-applied;
 if(delta<=0)return;
 obj.level=Math.min(100,initial+delta);
 obj.appliedSkillLevels=applied+delta;
 obj.source=(obj.source||"Player-entered")+" · mission progression";
}

