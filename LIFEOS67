function answerQuestion(i){
 if(!currentQuestion)return;
 const q=currentQuestion;
 const correct=i===q.correct;
 state.games++;
 if(correct)state.gameCorrect++;
 const today=dayKey();
 if(state.gameDay!==today){state.gameDay=today;state.gameXP=0}
 const reward=correct&&state.gameXP<50?Math.min(5,50-state.gameXP):0;
 state.gameXP+=reward;state.xp+=reward;
 document.getElementById("gamearea").innerHTML=`
  <strong class="${correct?"good":"warning"}">${correct?"Correct!":"Not quite."}</strong>
  <p>${esc(q.why)}</p><p>${reward?"You earned "+reward+" XP.":correct?"Daily minigame XP cap reached.":"No XP awarded for this answer."}</p>
  <button class="action primary" onclick="newQuestion()">Next question</button>`;
 currentQuestion=null;save();
}

