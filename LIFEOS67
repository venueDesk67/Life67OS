
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#100d20">
<title>LIFE OS67 — Living RPG</title>
<style>
:root{
 --bg:#100d20;--panel:#1b1630;--panel2:#241d3d;--panel3:#302747;
 --gold:#d9b66d;--purple:#9474d8;--text:#eee9df;
 --muted:#aaa1b8;--line:#403652;--green:#80b99a;--red:#d88989;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--text);font-family:Georgia,"Times New Roman",serif}
button,input,textarea,select{font:inherit}
button{cursor:pointer}
header{padding:17px 16px;background:#171229;border-bottom:1px solid var(--line);position:sticky;top:0;z-index:5}
.brand{font-size:24px;letter-spacing:3px;color:var(--gold)}
.subtitle{color:var(--muted);font-size:11px;margin-top:5px}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;padding:10px}
.stat,.panel,.tile{background:var(--panel);border:1px solid var(--line);border-radius:9px}
.stat{padding:10px 5px;text-align:center}
.stat strong{display:block;color:var(--gold);font-size:21px}
.stat span{font-size:10px;color:var(--muted)}
nav{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;padding:8px 10px;background:var(--bg)}
nav button,.action{
 background:var(--panel2);border:1px solid var(--line);color:var(--text);
 padding:11px 7px;border-radius:6px;font-size:12px;min-height:40px
}
nav button.active,.action.primary{border-color:var(--gold);color:var(--gold);background:#302747}
.action:active,nav button:active{transform:scale(.98)}
main{padding:10px 12px 35px;max-width:950px;margin:auto}
section{display:none}
section.active{display:block}
h2{font-size:20px;color:var(--gold);font-weight:normal;margin:9px 0 15px}
h3{font-size:15px;color:var(--gold);font-weight:normal;margin:5px 0 10px}
p,.muted{color:var(--muted);line-height:1.5;font-size:13px}
.panel{padding:13px;margin-bottom:11px}
.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
.tile{padding:11px;min-width:0}
.tile strong{display:block;margin-bottom:5px}
.row{display:flex;align-items:center;justify-content:space-between;gap:9px}
.row.wrap{flex-wrap:wrap}
.bar{height:7px;background:#090713;border-radius:10px;overflow:hidden;margin:8px 0}
.bar i{display:block;height:100%;background:var(--gold);border-radius:10px}
.small{font-size:11px;color:var(--muted)}
.tag{font-size:10px;color:var(--purple);text-transform:uppercase;letter-spacing:.5px}
.good{color:var(--green)}.warning{color:var(--gold)}.danger{color:var(--red)}
input,textarea,select{
 width:100%;background:#100d20;border:1px solid var(--line);color:var(--text);
 padding:11px;border-radius:6px;margin:5px 0 10px;min-height:42px
}
textarea{min-height:100px;resize:vertical}
label{display:block;font-size:11px;color:var(--muted);margin-top:5px}
.action{margin:4px 3px 4px 0}
.skill{padding:10px 0;border-bottom:1px solid var(--line)}
.skill:last-child{border:0}
.level{width:70px!important;text-align:center;padding:7px}
.locked{opacity:.72}
.chat{background:#100d20;padding:12px;border-radius:7px;margin:8px 0;white-space:pre-wrap;font-size:13px;line-height:1.5;max-height:330px;overflow:auto}
.mission{border-left:3px solid var(--purple)}
.mission.easy{border-left-color:var(--green)}
.mission.hard{border-left-color:var(--gold)}
.mission h3{margin-bottom:5px}
.mission-meta{display:flex;flex-wrap:wrap;gap:9px;font-size:11px;color:var(--muted);margin:9px 0}
.objective{background:#100d20;padding:10px;border-radius:6px;color:var(--text);font-size:13px;line-height:1.5}
.empty{padding:18px;text-align:center;color:var(--muted)}
hr{border:0;border-top:1px solid var(--line);margin:13px 0}
footer{text-align:center;padding:20px;color:var(--muted);font-size:11px}
button:focus,input:focus,textarea:focus,select:focus{outline:1px solid var(--gold);outline-offset:1px}
@media(min-width:650px){
 nav{grid-template-columns:repeat(8,1fr);position:sticky;top:76px;z-index:4}
 .grid{grid-template-columns:repeat(3,minmax(0,1fr))}
 main{padding-top:18px}
}
@media(max-width:370px){
 .brand{font-size:21px}
 nav button{font-size:11px;padding:9px 3px}
 .grid{grid-template-columns:1fr}
}
</style>
</head>
<body>
<header>
 <div class="brand">LIFE OS67</div>
 <div class="subtitle">THE BRAIN TREE · YOUR REAL-LIFE DEVELOPMENT RPG</div>
</header>

<div class="stats">
 <div class="stat"><strong id="level">01</strong><span>PLAYER LEVEL</span></div>
 <div class="stat"><strong id="xp">0</strong><span>NEW PLAYER XP</span></div>
 <div class="stat"><strong id="unlocks">0</strong><span>TREE BRANCHES</span></div>
</div>

<nav id="nav">
 <button class="active" data-tab="home">Home</button>
 <button data-tab="profile">Profile</button>
 <button data-tab="tree">Brain Tree</button>
 <button data-tab="missions">Missions</button>
 <button data-tab="games">Minigames</button>
 <button data-tab="projects">Projects</button>
 <button data-tab="ai">Matt's AI</button>
 <button data-tab="data">Data</button>
</nav>

<main>
<section id="home" class="active">
 <h2>PLAYER DASHBOARD</h2>
 <div class="panel">
  <div class="row wrap"><strong>Welcome back, Player</strong><span class="tag">UNLIMITED GROWTH</span></div>
  <p>LIFE OS67 is your real-life RPG. Choose an area, take on a challenge, do the work, record evidence and develop your character.</p>
  <div class="bar"><i id="xpbar" style="width:0%"></i></div>
  <div class="row small"><span id="xptext">0 / 100 XP</span><span id="nextlevel">100 XP to next level</span></div>
  <p class="small" id="levelmessage">Your next level is earned through completed challenges.</p>
 </div>

 <div class="grid">
  <div class="tile"><strong>Player Profile</strong><p>Attributes, skills and specialisations.</p><button class="action" onclick="show('profile')">Open character</button></div>
  <div class="tile"><strong>Brain Tree</strong><p>Explore development branches and unlocks.</p><button class="action" onclick="show('tree')">Explore tree</button></div>
  <div class="tile"><strong>Mission Board</strong><p>Choose from challenges for every levelable area.</p><button class="action primary" onclick="show('missions')">Choose mission</button></div>
  <div class="tile"><strong>Minigames</strong><p>Test knowledge, reasoning and decisions.</p><button class="action" onclick="show('games')">Play</button></div>
  <div class="tile"><strong>Projects</strong><p>Connect development to real projects.</p><button class="action" onclick="show('projects')">Open projects</button></div>
  <div class="tile"><strong>Matt's Level AI</strong><p>Get a profile-aware development recommendation.</p><button class="action" onclick="show('ai')">Talk to AI</button></div>
 </div>

 <div class="panel">
  <h3>YOUR NEXT ACTION</h3>
  <p id="nextaction">Choose a mission target to begin.</p>
  <button class="action primary" onclick="show('missions')">Go to mission board</button>
 </div>

 <div class="panel">
  <h3>HISTORICAL PROFILE — PRESERVED</h3>
  <div class="grid">
   <div><strong>515 XP</strong><p class="small">Historical XP record</p></div>
   <div><strong>61.8 / 100</strong><p class="small">Historical core average</p></div>
   <div><strong>15</strong><p class="small">Historical specialisations</p></div>
  </div>
  <p class="small">Historical records are not added to new XP. New gameplay progress is tracked separately.</p>
 </div>
 <div class="panel">
  <h3>RECENT GAMEPLAY</h3>
  <div id="recentactivity" class="small">No new missions completed yet.</div>
 </div>
</section>

<section id="profile">
 <div class="row"><h2>PLAYER CHARACTER</h2><button class="action" onclick="goBack()">Back</button></div>
 <div class="panel">
  <div class="row"><strong>PLAYER LEVEL <span id="profilelevel">01</span></strong><span class="tag">CHARACTER SHEET</span></div>
  <div class="bar"><i id="profilebar" style="width:0%"></i></div>
  <p id="profilexp" class="small">0 / 100 XP to next level</p>
 </div>
 <div class="panel">
  <h3>CORE ATTRIBUTES</h3>
  <p>Historical levels are preserved. New skill XP can develop a recorded level through completed, relevant missions.</p>
  <div id="attributes"></div>
 </div>
 <div class="panel">
  <h3>SPECIALISATIONS</h3>
  <p>Open a specialisation to inspect its recovered skills and access its mission set.</p>
  <div id="specialisations"></div>
  <div id="specialdetail"></div>
 </div>
 <div class="panel">
  <h3>ADDITIONAL SKILLS</h3>
  <label>Skill name</label><input id="skillname" placeholder="e.g. Financial management">
  <label>Starting level (1–100)</label><input id="skilllevel" type="number" min="1" max="100" value="50">
  <label>Source</label>
  <select id="skillsource"><option>Player-entered</option><option>AI-assessed</option><option>Evidence-supported</option><option>Verified</option></select>
  <label>Evidence or notes</label><textarea id="skillevidence" placeholder="What supports this level?"></textarea>
  <button class="action primary" onclick="addSkill()">Add skill to character</button>
  <div id="customskills"></div>
 </div>
 <div class="panel">
  <h3>ABILITIES</h3>
  <p>Add abilities you want to develop. Each ability receives its own three-mission pathway.</p>
  <input id="abilityname" placeholder="Ability name">
  <button class="action primary" onclick="addAbility()">Add ability</button>
  <div id="abilitylist"></div>
 </div>
</section>

<section id="tree">
 <div class="row"><h2>THE BRAIN TREE</h2><button class="action" onclick="goBack()">Back</button></div>
 <div class="panel">
  <p>Branches unlock automatically when their published new-XP requirements are reached. Unlocking grants access to develop that area; it does not mean mastery.</p>
  <p class="small">Select any branch to view its progress and three development missions.</p>
 </div>
 <div id="treecontent"></div>
</section>

<section id="missions">
 <div class="row"><h2>MISSION BOARD</h2><button class="action" onclick="goBack()">Back</button></div>
 <div class="panel">
  <span class="tag">DYNAMIC MISSION GENERATOR</span>
  <h3>Choose what you want to develop</h3>
  <label>Mission target</label>
  <select id="missiontarget" onchange="renderMissions()"></select>
  <p class="small" id="targetsummary">Choose an attribute, skill, specialisation, ability, branch or Player Level.</p>
  <div class="row wrap">
   <span class="small" id="missioncount">3 available missions</span>
   <span class="small">New challenges appear as you complete them.</span>
  </div>
 </div>
 <div id="missionlist"></div>
 <div class="panel">
  <h3>MISSION HISTORY</h3>
  <div id="missionhistory" class="small">No completed missions yet.</div>
 </div>
</section>

<section id="challenge">
 <div class="row"><h2>ACTIVE CHALLENGE</h2><button class="action" onclick="show('missions')">Mission board</button></div>
 <div id="challengearea"></div>
</section>

<section id="games">
 <div class="row"><h2>MINIGAMES</h2><button class="action" onclick="goBack()">Back</button></div>
 <div class="panel">
  <h3>KNOWLEDGE ARENA</h3>
  <p>Answer questions and receive feedback. Correct answers earn a small amount of practice XP, subject to the daily cap.</p>
  <div id="gamearea"><button class="action primary" onclick="newQuestion()">Start knowledge challenge</button></div>
 </div>
 <div class="panel">
  <h3>DECISION SIMULATOR</h3>
  <p>Consider a situation, choose an action and explain your reasoning.</p>
  <button class="action primary" onclick="startDecision()">Start decision challenge</button>
  <div id="decisionarea"></div>
 </div>
 <div class="panel">
  <h3>MINIGAME RECORD</h3>
  <p id="gamestats">No games played yet.</p>
 </div>
</section>

<section id="projects">
 <div class="row"><h2>PROJECT ARCHIVE</h2><button class="action" onclick="goBack()">Back</button></div>
 <div class="panel">
  <h3>ADD PROJECT</h3>
  <label>Project name</label><input id="projectname" placeholder="Project name">
  <label>Purpose, progress and notes</label><textarea id="projectdesc"></textarea>
  <button class="action primary" onclick="addProject()">Save project</button>
 </div>
 <div id="projectlist"></div>
</section>

<section id="ai">
 <div class="row"><h2>MATT'S LEVEL AI</h2><button class="action" onclick="goBack()">Back</button></div>
 <div class="panel">
  <span class="tag">LOCAL GAME MASTER MODE</span>
  <p>Ask about your character, progression, missions, strengths, missing information or what to work on next.</p>
  <div id="chatlog" class="chat">Matt's Level AI: Ready. I can inspect your saved profile and gameplay records, recommend a development target and explain your progression. I am currently running locally, not through an external AI model.</div>
  <textarea id="question" placeholder="Ask Matt's Level AI..."></textarea>
  <button class="action primary" onclick="askAI()">Send</button>
  <button class="action" onclick="clearChat()">Clear chat</button>
 </div>
 <div class="panel">
  <h3>GAME MASTER STATUS</h3>
  <p id="aistatus">Local profile-aware intelligence is active.</p>
  <p class="small">Local assessment uses transparent rules and the evidence you submit. It does not independently verify real-world abilities. A secure backend is needed for genuine external AI assessment.</p>
 </div>
</section>

<section id="data">
 <div class="row"><h2>DATA MANAGEMENT</h2><button class="action" onclick="goBack()">Back</button></div>
 <div class="panel">
  <h3>BACK UP YOUR GAME</h3>
  <p>Export your complete profile, missions, progress, evidence and project archive before changing devices.</p>
  <button class="action primary" onclick="exportData()">Export backup</button>
  <hr>
  <h3>RESTORE BACKUP</h3>
  <input type="file" id="importfile" accept=".json,application/json">
  <button class="action" onclick="importData()">Import backup</button>
  <hr>
  <h3>DATA STATUS</h3>
  <p id="datastatus">Local storage active.</p>
  <button class="action" onclick="resetData()">Reset new gameplay data</button>
  <p class="small">Reset returns new gameplay progress to its starting point. Historical seed records remain. Export first.</p>
 </div>
</section>
</main>
<footer>LIFE OS67 · UNLIMITED GROWTH · LIVING RPG VERSION 0.6</footer>

<script>
"use strict";

const KEY="lifeos67_v06";
const OLD_KEY="lifeos67_v05";

const historical={
 attributes:[
  ["Intelligence",74.5],["Communication",71.5],["Execution",66],
  ["Strategy",62.5],["Resilience",62],["Independence & Freedom",60],
  ["Leadership & Team",50],["Creation",47.9]
 ],
 specs:[
  {id:"S01",name:"Business & Entrepreneurship",avg:61.7,skills:[["Business knowledge",55],["Planning",65],["Development",55],["Entrepreneurship",75],["Marketing",55],["Operations",65]]},
  {id:"S02",name:"Hospitality & Mixology",avg:80,skills:[["Hospitality",85],["Bartending",90],["Mixology",85],["Cocktails",80],["Customer service",85],["Guest experience",80],["Bar operations",85],["Restaurant operations",65],["Staff training",70]]},
  {id:"S03",name:"Event Management",avg:68.9,skills:[["Planning",70],["Coordination",65],["Experience design",85],["Entertainment",65],["Suppliers",55],["Venue",75],["Marketing",65],["Guest management",75]]},
  {id:"S04",name:"Psychology & Human Behaviour",avg:59,skills:[["Human behaviour",55],["Emotional intelligence",50],["Self-awareness",80],["Empathy",60],["Motivation",65],["Personality",45],["Social dynamics",65],["Conflict psychology",40]]},
  {id:"S05",name:"Technology",avg:50,skills:[]},
  {id:"S06",name:"Artificial Intelligence",avg:73.8,skills:[]},
  {id:"S07",name:"Game Development",avg:66,skills:[["Game design",65],["Mechanics",70],["World-building",85],["Narrative",80],["Level design",65],["Progression",80],["Character",70],["UI",65],["Programming",20],["Production",45]]},
  {id:"S08",name:"Pokémon",avg:71,skills:[]},
  {id:"S09",name:"Education",avg:65.5,skills:[]},
  {id:"S10",name:"Finance & Economics",avg:52.8,skills:[]},
  {id:"S11",name:"Marketing & Branding",avg:71.5,skills:[]},
  {id:"S12",name:"Research & Investigation",avg:77.5,skills:[]},
  {id:"S13",name:"Creative Writing & Comics",avg:76,skills:[]},
  {id:"S14",name:"Project Architecture",avg:76.5,skills:[]},
  {id:"S15",name:"Human Team Development",avg:70,skills:[]}
 ],
 projects:[
  ["Hosted By Matt","Training project"],
  ["PokeLevelUp","Training project"],
  ["Trainer Matt: Wildbound","Training project"],
  ["Aiko's World","Training project"],
  ["Hospitality","Training project"],
  ["VenueDesk","Training project"],
  ["Captain Obvious","Training project"]
 ]
};

const branches=[
 {id:"knowledge",name:"Knowledge",desc:"Learning, understanding and information.",req:0,attribute:"Intelligence"},
 {id:"communication",name:"Communication",desc:"Expression, listening and connection.",req:50,attribute:"Communication"},
 {id:"strategy",name:"Strategy",desc:"Planning, decisions and long-term thinking.",req:100,attribute:"Strategy"},
 {id:"creation",name:"Creation",desc:"Design, imagination and building.",req:150,attribute:"Creation"},
 {id:"execution",name:"Execution",desc:"Turning plans into completed work.",req:200,attribute:"Execution"},
 {id:"leadership",name:"Leadership",desc:"People, teams and direction.",req:250,attribute:"Leadership & Team"},
 {id:"resilience",name:"Resilience",desc:"Adaptation and persistence.",req:300,attribute:"Resilience"},
 {id:"independence",name:"Independence",desc:"Self-direction and freedom.",req:350,attribute:"Independence & Freedom"}
];

const questions=[
 {q:"Which is the best first step when building a project?",a:["Plan the objective","Spend money immediately","Add decoration"],correct:0,why:"A clear objective gives the project direction and makes decisions measurable."},
 {q:"What does evidence-supported mean?",a:["A guess","An assessment backed by evidence","A locked skill"],correct:1,why:"Evidence-supported means there is relevant information or an example supporting the assessment."},
 {q:"Which is most important when testing software?",a:["Assume it works","Avoid testing","Check actual behaviour"],correct:2,why:"Testing means checking what the software actually does, including edge cases."},
 {q:"What is a useful strategy?",a:["A clear plan toward a goal","A random action","A completed reward"],correct:0,why:"A strategy connects a goal to choices, resources and actions."},
 {q:"What should an AI do with missing historical data?",a:["Invent it","Mark it unknown","Hide the gap"],correct:1,why:"Unknown information should remain unknown until supported by evidence."},
 {q:"What makes a useful mission?",a:["A vague intention","A measurable objective","A reward with no activity"],correct:1,why:"A measurable objective makes it possible to assess whether the task was completed."}
];

let state;
let currentMission=null;
let currentQuestion=null;
let navHistory=["home"];
let currentDecision=null;

function fresh(){
 return {
  version:6,xp:0,missions:[],missionCounts:{},missionHistory:[],
  skillXP:{},abilities:[],customSkills:[],games:0,gameXP:0,gameDay:"",
  gameCorrect:0,streak:0,lastMissionDay:"",
  projects:historical.projects.map(x=>({name:x[0],desc:x[1],status:"Training archive"})),
  attributes:historical.attributes.map(x=>({name:x[0],level:x[1],source:"Historical AI assessment"})),
  specs:historical.specs.map(x=>({...x,skills:x.skills.map(s=>({name:s[0],level:s[1],source:"Historical AI assessment"}))}))
 };
}

function normalise(s){
 const base=fresh();
 const out={...base,...s,version:6};
 out.attributes=Array.isArray(s.attributes)?s.attributes:base.attributes;
 out.specs=Array.isArray(s.specs)?s.specs:base.specs;
 out.projects=Array.isArray(s.projects)?s.projects:base.projects;
 out.customSkills=Array.isArray(s.customSkills)?s.customSkills:[];
 out.abilities=Array.isArray(s.abilities)?s.abilities:[];
 out.missions=Array.isArray(s.missions)?s.missions:[];
 out.missionHistory=Array.isArray(s.missionHistory)?s.missionHistory:[];
 out.missionCounts=s.missionCounts||{};
 out.skillXP=s.skillXP||{};
 out.xp=Number(s.xp)||0;
 out.gameXP=Number(s.gameXP)||0;
 return out;
}

function load(){
 try{
  const current=localStorage.getItem(KEY);
  if(current){state=normalise(JSON.parse(current));return}
  const old=localStorage.getItem(OLD_KEY);
  if(old){
   const oldState=JSON.parse(old);
   state=normalise(oldState);
   save(false);
   return;
  }
  state=fresh();
  save(false);
 }catch(e){
  state=fresh();
  console.error("LIFE OS67 load issue",e);
 }
}

function save(doRender=true){
 try{
  localStorage.setItem(KEY,JSON.stringify(state));
  if(doRender)render();
 }catch(e){
  alert("Your browser could not save this change. Export a backup and check available device storage.");
  console.error(e);
 }
}

function esc(value){
 return String(value??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
}
function slug(value){
 return String(value).toLowerCase().replace(/[^a-z0-9]+/g,"-").replace(/^-|-$/g,"");
}
function dayKey(){
 const d=new Date();
 return d.getFullYear()+"-"+String(d.getMonth()+1).padStart(2,"0")+"-"+String(d.getDate()).padStart(2,"0");
}
function playerLevel(){return Math.floor(state.xp/100)+1}
function playerLevelProgress(){return state.xp%100}
function unlockedBranches(){return branches.filter(b=>state.xp>=b.req).length}
function goBack(){
 if(navHistory.length>1)navHistory.pop();
 const previous=navHistory[navHistory.length-1]||"home";
 activateSection(previous,false);
}
function show(id,targetId){
 if(!document.getElementById(id))return;
 if(navHistory[navHistory.length-1]!==id)navHistory.push(id);
 activateSection(id,true);
 if(id==="missions"&&targetId){
  const select=document.getElementById("missiontarget");
  if(select){select.value=targetId;renderMissions()}
 }
}
function activateSection(id,scroll){
 document.querySelectorAll("main section").forEach(x=>x.classList.toggle("active",x.id===id));
 document.querySelectorAll("nav button").forEach(x=>x.classList.toggle("active",x.dataset.tab===id));
 if(scroll)window.scrollTo({top:0,behavior:"smooth"});
}
document.getElementById("nav").addEventListener("click",e=>{
 const b=e.target.closest("button[data-tab]");
 if(b)show(b.dataset.tab);
});

function getTarget(id){
 if(id==="player")return {id,type:"player",name:"Player Level",level:playerLevel(),source:"Gameplay progression",obj:state};
 const a=state.attributes.find(x=>"attribute:"+slug(x.name)===id);
 if(a)return {id,type:"attribute",name:a.name,level:a.level,source:a.source,obj:a};
 const branch=branches.find(x=>"branch:"+x.id===id);
 if(branch)return {id,type:"branch",name:branch.name,level:state.xp,source:"Automatic unlock progression",obj:branch};
 const spec=state.specs.find(x=>"spec:"+x.id===id);
 if(spec)return {id,type:"specialisation",name:spec.name,level:spec.avg,source:"Historical specialisation average",obj:spec};
 for(const s of state.specs){
  const k=s.skills.find(x=>"skill:"+s.id+":"+slug(x.name)===id);
  if(k)return {id,type:"skill",name:k.name,level:k.level,source:k.source,obj:k,spec:s};
 }
 const custom=state.customSkills.find(x=>"custom:"+x.id===id);
 if(custom)return {id,type:"skill",name:custom.name,level:custom.level,source:custom.source,obj:custom};
 const ability=state.abilities.find(x=>"ability:"+x.id===id);
 if(ability)return {id,type:"ability",name:ability.name,level:ability.level,source:"Player-created ability",obj:ability};
 return null;
}

function allTargets(){
 const list=[{id:"player",type:"player",name:"Player Level",level:playerLevel()}];
 state.attributes.forEach(a=>list.push({id:"attribute:"+slug(a.name),type:"attribute",name:a.name,level:a.level}));
 state.specs.forEach(s=>{
  list.push({id:"spec:"+s.id,type:"specialisation",name:s.name,level:s.avg});
  s.skills.forEach(k=>list.push({id:"skill:"+s.id+":"+slug(k.name),type:"skill",name:s.name+" — "+k.name,level:k.level}));
 });
 state.customSkills.forEach(s=>list.push({id:"custom:"+s.id,type:"skill",name:s.name,level:s.level}));
 state.abilities.forEach(a=>list.push({id:"ability:"+a.id,type:"ability",name:a.name,level:a.level}));
 branches.forEach(b=>list.push({id:"branch:"+b.id,type:"branch",name:b.name,level:state.xp}));
 return list;
}

function skillProgress(id){return Number(state.skillXP[id]||0)}
function skillLevelFromXP(target){
 if(!target||target.type==="player"||target.type==="branch")return target?.level||0;
 const earned=skillProgress(target.id);
 return Math.min(100,Number(target.level||1)+Math.floor(earned/100));
}
function missionCycle(id){return Number(state.missionCounts[id]||0)}

const missionPatterns=[
 [
  {name:"Understand the foundations",kind:"Knowledge",minutes:10,base:10,task:"Explain the most important principles of {name}. Give at least two specific points and explain why they matter."},
  {name:"Apply it to a real situation",kind:"Practical",minutes:20,base:20,task:"Choose a realistic situation where {name} would be useful. Work through the situation, describe your actions and explain the result you would aim for."},
  {name:"Demonstrate your ability",kind:"Performance",minutes:30,base:30,task:"Complete a small practical demonstration of {name}. Record what you did, the result, what evidence supports it and what you would improve next time."}
 ],
 [
  {name:"Teach it back",kind:"Knowledge",minutes:12,base:12,task:"Teach the key ideas of {name} in your own words as if explaining them to a beginner. Include an example and one common mistake."},
  {name:"Solve a challenge",kind:"Problem-solving",minutes:25,base:22,task:"Create or find a problem that requires {name}. Show your reasoning step by step and explain why your chosen solution is appropriate."},
  {name:"Build a proof of practice",kind:"Practical",minutes:35,base:32,task:"Produce a small piece of work that demonstrates {name}. Describe the process, the finished result and the evidence you could use to review it."}
 ],
 [
  {name:"Analyse a case",kind:"Analysis",minutes:15,base:15,task:"Analyse a real or realistic example involving {name}. Identify the goal, the important factors, your options and the strongest conclusion."},
  {name:"Make and defend a decision",kind:"Decision",minutes:20,base:24,task:"Set up a decision where {name} matters. Compare at least two options, choose one and defend your decision with clear reasons."},
  {name:"Complete a stretch objective",kind:"Mastery",minutes:40,base:35,task:"Set yourself a challenging but achievable task involving {name}. Complete it, record the outcome and identify the next step that would make the task harder."}
 ]
];

function makeMissionSet(target){
 const cycle=missionCycle(target.id);
 const pattern=missionPatterns[cycle%missionPatterns.length];
 const currentLevel=skillLevelFromXP(target);
 return pattern.map((p,index)=>{
  const difficulty=index===0?"Easy":index===1?"Medium":"Hard";
  const scale=Math.max(0,Math.floor((currentLevel-40)/20));
  const xp=p.base+scale*2+(playerLevel()>10?2:0);
  const id=target.id+"|"+cycle+"|"+index;
  return {
   id,targetId:target.id,targetName:target.name,title:p.name+" · "+target.name,
   kind:p.kind,difficulty,minutes:p.minutes+scale*2,xp:Math.min(60,xp),
   objective:p.task.replaceAll("{name}",target.name),
   cycle,index
  };
 });
}

